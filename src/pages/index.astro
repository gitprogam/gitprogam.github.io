---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/content';
import { homeSections } from '../lib/projects';

const sections = homeSections(await getProjects());
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@type': 'Person', alternateName: 'gitprogam', url: 'https://gitprogam.github.io/', sameAs: ['https://github.com/gitprogam'] },
};
---
<BaseLayout title="gitprogam" description="북곽툴즈, StudyAce, BBlog 등 직접 만들고 운영하는 프로젝트 모음." jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 pt-14 pb-20 sm:px-6 sm:pt-20">
    <h1 class="text-[2.125rem] leading-tight font-bold tracking-[-0.03em] sm:text-5xl">gitprogam</h1>
    <p class="mt-4 max-w-xl text-lg text-sub">북곽툴즈, StudyAce, BBlog 등을 만들고 운영하고 있습니다.</p>

    <div id="projects" class="scroll-mt-20">
      {sections.map((s) => (
        <section data-section={s.key} class="mt-16">
          <h2 class="text-sm font-semibold text-sub">{s.title}</h2>
          {s.key === 'live' ? (
            <div class="mt-4 space-y-4">
              <ProjectCard entry={s.items[0]} variant="feature" />
              {s.items.length > 1 && (
                <div class="grid gap-4 sm:grid-cols-2">
                  {s.items.slice(1).map((e) => <ProjectCard entry={e} variant="tile" />)}
                </div>
              )}
            </div>
          ) : (
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {s.items.map((e) => <ProjectCard entry={e} variant="tile" />)}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
