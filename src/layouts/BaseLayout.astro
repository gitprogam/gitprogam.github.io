---
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props { title: string; description: string; image?: string; jsonLd?: object; noindex?: boolean }
const { title, description, image, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
    <Analytics />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 text-sm sm:px-6" aria-label="주 메뉴">
        <a href="/" class="font-semibold">gitprogam</a>
        <div class="flex gap-5 text-sub">
          <a href="/#projects" class="hover:text-ink">프로젝트</a>
          <a href="/about/" class="hover:text-ink">소개</a>
        </div>
      </nav>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-2 px-4 py-8 text-sm text-sub sm:px-6">
        <span>gitprogam</span>
        <a href="https://github.com/gitprogam" class="hover:text-ink">GitHub</a>
      </div>
    </footer>
  </body>
</html>
